# Copy to .env. Never commit the real .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=0
ALLOWED_HOSTS=school.example.ru
CSRF_TRUSTED_ORIGINS=https://school.example.ru
# Keep 0 until HTTPS is configured; set to 1 after installing a valid certificate.
SECURE_SSL_REDIRECT=0
POSTGRES_DB=gym4_elections
POSTGRES_USER=gym4
POSTGRES_PASSWORD=replace-with-a-long-random-password
